<?xml version="1.0" encoding="utf-8"?>
<!-- What Android's cloud backup and device-to-device transfer keep of the
     app's storage from Android 12 (android:dataExtractionRules): as
     backup_rules.xml explains. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="install/" />
        <exclude domain="file" path="install.tmp/" />
        <exclude domain="file" path="INSTALL.CFG" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="install/" />
        <exclude domain="file" path="install.tmp/" />
        <exclude domain="file" path="INSTALL.CFG" />
    </device-transfer>
</data-extraction-rules>
