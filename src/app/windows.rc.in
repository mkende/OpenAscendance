// The Windows resources of the game's executable: its icon (when the build
// is given one, OA_WINDOWS_ICON: packaging/icon/icon.ico by default), its
// version information and its manifest.
// Generated by CMake from app/windows.rc.in.
#include <winver.h>

@OA_WINDOWS_ICON_RESOURCE@
1 24 "@OA_WINDOWS_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @OA_VERSION_MAJOR@,@OA_VERSION_MINOR@,@OA_VERSION_PATCH@,0
PRODUCTVERSION @OA_VERSION_MAJOR@,@OA_VERSION_MINOR@,@OA_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "@OA_PREF_ORG@"
      VALUE "FileDescription", "@OA_NAME@"
      VALUE "FileVersion", "@OA_VERSION@"
      VALUE "InternalName", "@OA_EXECUTABLE@"
      VALUE "OriginalFilename", "@OA_EXECUTABLE@.exe"
      VALUE "ProductName", "@OA_NAME@"
      VALUE "ProductVersion", "@OA_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
